<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- App Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E3A8A"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Clinical Co-Pilot"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_header_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#2563EB"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Offline Mode"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Container For Screens -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- ================= SCREEN 1: HOME / DASHBOARD ================= -->
            <LinearLayout
                android:id="@+id/screen_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Title Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clinical Diagnostic Co-Pilot"
                        android:textColor="#1E3A8A"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Decision Support System"
                        android:textColor="#64748B"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Mode Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#EFF6FF"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Inference Mode:"
                        android:textColor="#1E3A8A"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinner_inference_mode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- Status Specs Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="System Status:"
                            android:textColor="#475569"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_system_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#D1FAE5"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="Operational"
                            android:textColor="#065F46"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Rounds Completed:"
                            android:textColor="#475569"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5"
                            android:textColor="#0F172A"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Participating Sites:"
                            android:textColor="#475569"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3"
                            android:textColor="#0F172A"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_goto_assessment"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:backgroundTint="#2563EB"
                    android:text="Patient Assessment"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ================= SCREEN 2: PATIENT ASSESSMENT ================= -->
            <LinearLayout
                android:id="@+id/screen_assessment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Patient Assessment"
                        android:textColor="#0F172A"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_cancel_assessment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="Cancel"
                        android:textColor="#2563EB"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Inputs Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Age & Gender -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Age (Years)" android:textSize="12sp" android:textStyle="bold" android:textColor="#334155"/>
                            <EditText android:id="@+id/et_age" android:layout_width="match_parent" android:layout_height="44dp" android:inputType="numberDecimal" android:text="55.5" android:textSize="14sp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gender" android:textSize="12sp" android:textStyle="bold" android:textColor="#334155"/>
                            <Spinner android:id="@+id/spinner_gender" android:layout_width="match_parent" android:layout_height="44dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Height & Weight -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Height (cm)" android:textSize="12sp" android:textStyle="bold" android:textColor="#334155"/>
                            <EditText android:id="@+id/et_height" android:layout_width="match_parent" android:layout_height="44dp" android:inputType="numberDecimal" android:text="165.0" android:textSize="14sp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Weight (kg)" android:textSize="12sp" android:textStyle="bold" android:textColor="#334155"/>
                            <EditText android:id="@+id/et_weight" android:layout_width="match_parent" android:layout_height="44dp" android:inputType="numberDecimal" android:text="70.0" android:textSize="14sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- BP Systolic & Diastolic -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Systolic BP (ap_hi)" android:textSize="12sp" android:textStyle="bold" android:textColor="#334155"/>
                            <EditText android:id="@+id/et_ap_hi" android:layout_width="match_parent" android:layout_height="44dp" android:inputType="number" android:text="140" android:textSize="14sp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Diastolic BP (ap_lo)" android:textSize="12sp" android:textStyle="bold" android:textColor="#334155"/>
                            <EditText android:id="@+id/et_ap_lo" android:layout_width="match_parent" android:layout_height="44dp" android:inputType="number" android:text="90" android:textSize="14sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Cholesterol -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cholesterol Level" android:textSize="12sp" android:textStyle="bold" android:textColor="#334155"/>
                        <Spinner android:id="@+id/spinner_cholesterol" android:layout_width="match_parent" android:layout_height="44dp"/>
                    </LinearLayout>

                    <!-- Glucose -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Glucose Level" android:textSize="12sp" android:textStyle="bold" android:textColor="#334155"/>
                        <Spinner android:id="@+id/spinner_glucose" android:layout_width="match_parent" android:layout_height="44dp"/>
                    </LinearLayout>

                    <!-- Smoking & Alcohol -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Smoking Status" android:textSize="12sp" android:textStyle="bold" android:textColor="#334155"/>
                            <Spinner android:id="@+id/spinner_smoke" android:layout_width="match_parent" android:layout_height="44dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Alcohol Intake" android:textSize="12sp" android:textStyle="bold" android:textColor="#334155"/>
                            <Spinner android:id="@+id/spinner_alco" android:layout_width="match_parent" android:layout_height="44dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Physical Activity -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="24dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Physical Activity" android:textSize="12sp" android:textStyle="bold" android:textColor="#334155"/>
                        <Spinner android:id="@+id/spinner_active" android:layout_width="match_parent" android:layout_height="44dp"/>
                    </LinearLayout>

                </LinearLayout>

                <Button
                    android:id="@+id/btn_analyze_patient"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:backgroundTint="#2563EB"
                    android:text="Analyze Patient"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ================= SCREEN 3: RESULT ================= -->
            <LinearLayout
                android:id="@+id/screen_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Assessment Result"
                    android:textColor="#0F172A"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Risk Card -->
                <LinearLayout
                    android:id="@+id/card_risk_primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FEF2F2"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tv_risk_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#FEE2E2"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="ELEVATED RISK"
                        android:textColor="#991B1B"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_probability"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="73.88%"
                        android:textColor="#1E3A8A"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="ESTIMATED RISK"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Patient Summary Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PATIENT SUMMARY"
                        android:textColor="#475569"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Blood Pressure" android:textColor="#64748B" android:textSize="13sp"/>
                        <TextView android:id="@+id/tv_res_bp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="140/90 mmHg" android:textColor="#0F172A" android:textSize="14sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="BMI" android:textColor="#64748B" android:textSize="13sp"/>
                        <TextView android:id="@+id/tv_res_bmi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="25.7 kg/m²" android:textColor="#0F172A" android:textSize="14sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Cholesterol" android:textColor="#64748B" android:textSize="13sp"/>
                        <TextView android:id="@+id/tv_res_cholesterol" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Above Normal" android:textColor="#0F172A" android:textSize="14sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Physical Activity" android:textColor="#64748B" android:textSize="13sp"/>
                        <TextView android:id="@+id/tv_res_activity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Active" android:textColor="#0F172A" android:textSize="14sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Smoking Status" android:textColor="#64748B" android:textSize="13sp"/>
                        <TextView android:id="@+id/tv_res_smoking" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Non-Smoker" android:textColor="#0F172A" android:textSize="14sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_new_assessment"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:backgroundTint="#2563EB"
                    android:text="New Assessment"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </FrameLayout>
    </ScrollView>
</LinearLayout>
