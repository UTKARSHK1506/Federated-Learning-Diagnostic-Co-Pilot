<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- Top Navigation Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E3A8A"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CardioSense"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cardiovascular Risk Assessment"
                android:textColor="#BFDBFE"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Status Indicator Pill -->
        <TextView
            android:id="@+id/tv_header_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#2563EB"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="[ Offline ]"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Scrollable Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- ================= SCREEN 1: LANDING PAGE ================= -->
            <LinearLayout
                android:id="@+id/screen_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="visible">

                <!-- Header / Branding -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CardioSense"
                        android:textColor="#1E3A8A"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Cardiovascular Risk Assessment"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Central Medical Illustration (Heart + ECG) -->
                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="14dp"
                    android:src="@drawable/ic_heart_pulse"
                    android:contentDescription="Cardiovascular Health Illustration" />

                <!-- Main Hero Text -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome to CardioSense"
                    android:textColor="#0F172A"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="20dp"
                    android:text="Understand your cardiovascular risk with a simple health assessment."
                    android:textColor="#475569"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:lineSpacingExtra="2dp" />

                <!-- Key Value Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_info"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Simple. Private. Accessible."
                        android:textColor="#1E3A8A"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Quick health assessment"
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Works without internet"
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Clear, easy-to-understand results"
                        android:textColor="#334155"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Primary Action: Get Started -->
                <Button
                    android:id="@+id/btn_goto_assessment"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:backgroundTint="#2563EB"
                    android:text="Get Started"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Secondary Action: How it works -->
                <TextView
                    android:id="@+id/btn_how_it_works"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:text="How it works"
                    android:textColor="#2563EB"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tv_how_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:padding="14dp"
                    android:text="CardioSense uses a trained cardiovascular risk model to analyze the information you provide."
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp" />

                <!-- Offline Indicator -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#EFF6FF"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓  Offline assessment available"
                        android:textColor="#1E40AF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Preserved hidden Spinner for mode binding compatibility -->
                <Spinner
                    android:id="@+id/spinner_inference_mode"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_mode_description"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ================= SCREEN 2: HEALTH ASSESSMENT ================= -->
            <LinearLayout
                android:id="@+id/screen_assessment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Section Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Health Assessment"
                            android:textColor="#0F172A"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Enter your current health information"
                            android:textColor="#475569"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btn_cancel_assessment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="Return"
                        android:textColor="#2563EB"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- SECTION 1: PERSONAL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PERSONAL"
                        android:textColor="#1E3A8A"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Age & Gender -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Age (Years)" android:textSize="12sp" android:textStyle="bold" android:textColor="#0F172A"/>
                            <EditText android:id="@+id/et_age" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_input" android:inputType="numberDecimal" android:text="55.5" android:textColor="#0F172A" android:textSize="14sp" android:textStyle="bold"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gender" android:textSize="12sp" android:textStyle="bold" android:textColor="#0F172A"/>
                            <Spinner android:id="@+id/spinner_gender" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:background="@drawable/bg_spinner"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Height & Weight -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Height (cm)" android:textSize="12sp" android:textStyle="bold" android:textColor="#0F172A"/>
                            <EditText android:id="@+id/et_height" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_input" android:inputType="numberDecimal" android:text="165.0" android:textColor="#0F172A" android:textSize="14sp" android:textStyle="bold"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Weight (kg)" android:textSize="12sp" android:textStyle="bold" android:textColor="#0F172A"/>
                            <EditText android:id="@+id/et_weight" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_input" android:inputType="numberDecimal" android:text="70.0" android:textColor="#0F172A" android:textSize="14sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- SECTION 2: VITALS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VITALS"
                        android:textColor="#1E3A8A"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Systolic & Diastolic BP -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Systolic BP (mmHg)" android:textSize="12sp" android:textStyle="bold" android:textColor="#0F172A"/>
                            <EditText android:id="@+id/et_ap_hi" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_input" android:inputType="number" android:text="140" android:textColor="#0F172A" android:textSize="14sp" android:textStyle="bold"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Diastolic BP (mmHg)" android:textSize="12sp" android:textStyle="bold" android:textColor="#0F172A"/>
                            <EditText android:id="@+id/et_ap_lo" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_input" android:inputType="number" android:text="90" android:textColor="#0F172A" android:textSize="14sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- SECTION 3: HEALTH & LIFESTYLE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HEALTH &amp; LIFESTYLE"
                        android:textColor="#1E3A8A"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- Cholesterol -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cholesterol Level" android:textSize="12sp" android:textStyle="bold" android:textColor="#0F172A"/>
                        <Spinner android:id="@+id/spinner_cholesterol" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:background="@drawable/bg_spinner"/>
                    </LinearLayout>

                    <!-- Glucose -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Glucose Level" android:textSize="12sp" android:textStyle="bold" android:textColor="#0F172A"/>
                        <Spinner android:id="@+id/spinner_glucose" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:background="@drawable/bg_spinner"/>
                    </LinearLayout>

                    <!-- Smoking & Alcohol -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Smoking Status" android:textSize="12sp" android:textStyle="bold" android:textColor="#0F172A"/>
                            <Spinner android:id="@+id/spinner_smoke" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:background="@drawable/bg_spinner"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Alcohol Intake" android:textSize="12sp" android:textStyle="bold" android:textColor="#0F172A"/>
                            <Spinner android:id="@+id/spinner_alco" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:background="@drawable/bg_spinner"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Physical Activity -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Physical Activity" android:textSize="12sp" android:textStyle="bold" android:textColor="#0F172A"/>
                        <Spinner android:id="@+id/spinner_active" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:background="@drawable/bg_spinner"/>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_analyze_patient"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:backgroundTint="#2563EB"
                    android:text="Assess Risk"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ================= SCREEN 3: RISK REPORT ================= -->
            <LinearLayout
                android:id="@+id/screen_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Risk Assessment"
                    android:textColor="#0F172A"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp" />

                <!-- Central Result Card -->
                <LinearLayout
                    android:id="@+id/card_risk_primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CARDIOVASCULAR RISK"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_probability"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="73.88%"
                        android:textColor="#1E3A8A"
                        android:textSize="40sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Estimated Risk"
                        android:textColor="#475569"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_risk_tag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="#FEE2E2"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="5dp"
                        android:text="ELEVATED POTENTIAL RISK"
                        android:textColor="#991B1B"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Horizontal Risk Scale Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RISK CATEGORY SCALE"
                        android:textColor="#1E3A8A"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <!-- 4 Horizontal Scale Segments -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/v_scale_low"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="3dp"
                            android:background="@drawable/bg_scale_inactive" />

                        <View
                            android:id="@+id/v_scale_mod"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="3dp"
                            android:background="@drawable/bg_scale_inactive" />

                        <View
                            android:id="@+id/v_scale_elev"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginEnd="3dp"
                            android:background="@drawable/bg_scale_active" />

                        <View
                            android:id="@+id/v_scale_high"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_scale_inactive" />
                    </LinearLayout>

                    <!-- Segment Labels -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:id="@+id/tv_lbl_low"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="LOW"
                            android:textColor="#64748B"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_lbl_mod"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="MODERATE"
                            android:textColor="#64748B"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_lbl_elev"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="ELEVATED"
                            android:textColor="#1E3A8A"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_lbl_high"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="HIGH"
                            android:textColor="#64748B"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Patient Summary Card ("Your Health Snapshot") -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Health Snapshot"
                        android:textColor="#1E3A8A"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Age" android:textColor="#475569" android:textSize="13sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tv_res_age" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="55.5 years" android:textColor="#0F172A" android:textSize="13sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="BMI" android:textColor="#475569" android:textSize="13sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tv_res_bmi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="25.7 kg/m²" android:textColor="#0F172A" android:textSize="13sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Blood Pressure" android:textColor="#475569" android:textSize="13sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tv_res_bp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="140/90 mmHg" android:textColor="#0F172A" android:textSize="13sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Cholesterol" android:textColor="#475569" android:textSize="13sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tv_res_cholesterol" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Level 2" android:textColor="#0F172A" android:textSize="13sp" android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Glucose" android:textColor="#475569" android:textSize="13sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/tv_res_glucose" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Level 1" android:textColor="#0F172A" android:textSize="13sp" android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Key Health Factors ("Factors Affecting Your Assessment") -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Factors Affecting Your Assessment"
                        android:textColor="#1E3A8A"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_contributing_factors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Blood pressure is above the normal range\n• Cholesterol level is elevated\n• BMI is above the recommended range"
                        android:textColor="#0F172A"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>

                <!-- Health Tips Card ("Health Tips") -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_info"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Health Tips"
                        android:textColor="#1E3A8A"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_health_tips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Monitor your blood pressure regularly and discuss persistent high readings with a healthcare professional.\n• Maintain a balanced diet and discuss cholesterol management with a healthcare professional."
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>

                <!-- Disclaimer Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_disclaimer"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Important Disclaimer"
                        android:textColor="#92400E"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="3dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="This assessment is for informational purposes and is not a medical diagnosis. Consult a qualified healthcare professional for medical advice."
                        android:textColor="#92400E"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <!-- Bottom Actions -->
                <Button
                    android:id="@+id/btn_new_assessment"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:backgroundTint="#2563EB"
                    android:text="New Assessment"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/btn_edit_assessment"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_button_secondary"
                    android:gravity="center"
                    android:text="Edit Information"
                    android:textColor="#1E3A8A"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="10dp" />
            </LinearLayout>

        </FrameLayout>
    </ScrollView>
</LinearLayout>
